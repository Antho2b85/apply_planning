{% extends 'base.html.twig' %}

{% block title %}Prévisions du jour{% endblock %}

{% block body %}
<header>
<div class="text-center border pt-2">
    <h1 class="txt-corsica-secondary">Prévisions de ce jour</h1>
</div>
</header>

<main>
<section>
<div class="d-flex flex-column gap-3 mx-2">
<div class="d-flex flex-column">
{% for prevision in previsions %}
{% set arrivee = arrivees[loop.index0] %}
<div class="card bg-corsica-grey my-2 position-relative w-100">
{% if is_granted('ROLE_ADMIN') %}
<button type="button"
        class="btn btn-link position-absolute end-0 pe-4 pt-3"
        data-bs-toggle="modal"
        data-bs-target="#modalPrevisions"
        data-id="{{ prevision.id }}"
        data-agents-reserves="{{ prevision.agentsReserves ?? '' }}"
        data-total-remorques="{{ prevision.totalRemorques ?? ''}}"
        data-embarque="{{ prevision.embarque ?? ''}}"
        data-titres="{{ prevision.titres ?? ''}}"
        data-attentes="{{ prevision.attentes ?? ''}}"
        data-agents-controle="{{ prevision.agentsControle ?? ''}}"
        data-total-passagers="{{ prevision.totalPassagers ?? ''}}"
        data-autos-basses="{{ prevision.autosBasses ?? ''}}"
        data-hauteurs="{{ prevision.hauteurs ?? ''}}"
        data-attelages="{{ prevision.attelages ?? ''}}"
        data-motos="{{ prevision.motos ?? ''}}"
        data-controles="{{ prevision.controles ?? ''}}"
        data-a-venir="{{ prevision.aVenir ?? ''}}"
        >
    <i class="bi bi-pencil-square"></i>
</button>
{% endif %}
<h5><span class="txt-corsica-red ms-1 mt-1">{{ arrivee.navire.nom ?? '-' }}</span></h5>
{# Carte frêt #}
<div class="row">
  <div class="card-body col-6">
    <h5 class="card-title py-3 ps-1">Frêt : </h5>
    
        <p>Agents réserves : <span class="txt-corsica-secondary">{{ prevision.agentsReserves ?? '-' }}</span></p>
        <p>Total remorques : {{ prevision.totalRemorques ?? '-' }}</p>
        <p>Titres : {{ prevision.titres ?? '-'}} / {{ prevision.totalRemorques ?? '-'}}</p>
        <p>Embarqués : {{ prevision.embarque ?? '-' }}</p>
        <p>Attentes : {{ prevision.attentes ?? '-'}}</p>
  </div>

{# Carte passagers #}
  <div class="card-body col-6">
  <h5 class="card-title py-3 ps-1">Passagers :</h5>
        <p>Agents contrôles : <span class="txt-corsica-secondary">{{ prevision.agentsControle ?? '-' }}</span></p>
        <p>Total passagers : {{ prevision.totalPassagers ?? '-' }}</p>
        <p>Autos basses : {{ prevision.autosBasses ?? '-'}}</p>
        <p>Hauteurs : {{ prevision.hauteurs ?? '-'}}</p>
        <p>Attelages : {{ prevision.attelages ?? '-'}}</p>
        <p>Motos : {{ prevision.motos ?? '-'}}</p>
        <p>Controlés : {{ prevision.controles ?? '-'}}</p>
        <p>À venir : {{ prevision.aVenir ?? '-'}}</p>
  </div>
  </div>
  </div>
{% endfor %}
</div>
{% if is_granted('ROLE_ADMIN') %}
{# Modal prévisions #}
<div class="modal fade" id="modalPrevisions" tabindex="-1" aria-labelledby="modalPrevisionLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalPrevisionLabel">Modifier prévisions</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="formPrevision">
            <input type="hidden" name="_token" value="{{ csrf_token('prevision_jour') }}">
            <input type="hidden" name="id" id="prevision-id">

      <div class="row">
      {# Partie gauche (modal frêt) #}
      <div class="col-6">
      <h6 class="underline">Frêt :</h6>

      <div>
  <label for="agentsReserves" class="col-form-label">Agents réserves</label>
  <input type="text" name="agentsReserves" id="agentsReserves" class="form-control">
</div>
      <div>
      <label for="totalRemorques" class="col-form-label">Total remorques</label>
      <input type="number" name="totalRemorques" id="totalRemorques" class="form-control">
      </div>
            <div>
      <label for="embarque" class="col-form-label">Embarqués</label>
      <input type="number" name="embarque" id="embarque" class="form-control">
      </div>
            <div>
      <label for="titres" class="col-form-label">Titres</label>
      <input type="number" name="titres" id="titres" class="form-control">
      </div>
                  <div>
      <label for="attentes" class="col-form-label">Attentes</label>
      <input type="number" name="attentes" id="attentes" class="form-control">
      </div>
      </div>

      {# Partie droite (modal passagers) #}
      <div class="col-6">
            <h6 class="underline">Passagers :</h6>

      <div>
  <label for="agentsControle" class="col-form-label">Agents contrôle</label>
  <input type="text" name="agentsControle" id="agentsControle" class="form-control">
</div>  
      <div>
      <label for="totalPassagers" class="col-form-label">total passagers</label>
      <input type="number" name="totalPassagers" id="totalPassagers" class="form-control">
      </div>
                  <div>
      <label for="autosBasses" class="col-form-label">Autos basses</label>
      <input type="number" name="autosBasses" id="autosBasses" class="form-control">
      </div>
                  <div>
      <label for="hauteurs" class="col-form-label">Hauteurs</label>
      <input type="number" name="hauteurs" id="hauteurs" class="form-control">
      </div>
                  <div>
      <label for="attelages" class="col-form-label">Attelages</label>
      <input type="number" name="attelages" id="attelages" class="form-control">
      </div>
                  <div>
      <label for="motos" class="col-form-label">Motos</label>
      <input type="number" name="motos" id="motos" class="form-control">
      </div>
                  <div>
      <label for="controles" class="col-form-label">Controlés</label>
      <input type="number" name="controles" id="controles" class="form-control">
      </div>
                  <div>
      <label for="aVenir" class="col-form-label">À venir</label>
      <input type="number" name="aVenir" id="aVenir" class="form-control">
      </div>

      
      </div>
      
      </div>

        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="button" class="btn btn-primary" id="btnEnvoyerPrevision">Envoyer</button>
      </div>
    </div>
  </div>
</div>
{% endif %}
</div>
</div>
</section>
</main>

{% block javascripts %}
{{ parent() }}
{{ importmap('previsions_du_jour') }}
{% endblock %}
{{ include('_partials/_footer.html.twig') }}

{% endblock %}
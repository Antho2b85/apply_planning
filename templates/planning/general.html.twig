{% extends 'base.html.twig' %}

{% block title %}Planning Général - Corsica Linea{% endblock %}

{% block body %}
<main>
    <div class="container-fluid d-flex align-items-baseline mt-4">
        <h3>Semaine {{ numeroSemaine }}</h3>
        <p class="mt-1 ms-2"> - du {{ texteDebut }} au {{ texteFin }}</p>
    </div>
    <hr>

    <section class="container-fluid mt-3">

        {# Onglets #}
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#equipe1">Équipe 1</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#equipe2">Équipe 2</button>
            </li>
        </ul>

        <div class="tab-content border border-top-0">

            {# ÉQUIPE 1 #}
            <div class="tab-pane active p-2" id="equipe1">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th class="text-center"><u>Agents</u></th>
                                {% for semaineDate in semaineDates %}
                                    <th class="txt-corsica-secondary text-center">
                                        <u>{{ semaineDate|format_date(pattern="EEEE d") }}</u>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in usersTeam1 %}
                                <tr>
                                    <th class="bg-corsica-grey txt-corsica-red text-center align-middle">
                                    {% if user.id.toRfc4122 === app.user.id.toRfc4122 %}
                                    <a href="{{ path('app_planning') }}">
                                    {{ user.prenom }} <br> {{ user.nom }}
                                    </a>
                                    {% else %}
                                        {{ user.prenom }} <br> {{ user.nom }}
                                    {% endif %}
                                    </th>
                                    {% for semaineDate in semaineDates %}
                                        <td>
                                            {% set userCreneaus = user.getCreneausPourDate(semaineDate) %}
                                            {% set creneauMatin = null %}
                                            {% set creneauAprem = null %}
                                            {% for uc in userCreneaus %}
                                                {% if uc.creneau.heureDebut|date('H') < 13 %}
                                                    {% set creneauMatin = uc %}
                                                {% else %}
                                                    {% set creneauAprem = uc %}
                                                {% endif %}
                                            {% endfor %}

                                {% set userId = user.id.toRfc4122 %}
                                {% set absence = absences[userId][semaineDate|date('Y-m-d')]['absenceUser'] ?? null %}
                                            <div class="mb-2 p-1 border-bottom cellule-matin small">
                                                {% if creneauMatin is not null %}
                                                    {{ creneauMatin.creneau.heureDebut|date('H:i') }} - {{ creneauMatin.creneau.heureFin|date('H:i') }} :
                                                    {{ creneauMatin.creneau.motifAbsence ?: creneauMatin.creneau.poste }}
                                                    {% else %}
                                                        {% if absence is not null %}
                                                        <span class="text-warning">{{ absence.motif }}</span>
                                                {% else %}
                                                    <span class="text-muted">+ Matin</span>
                                                {% endif %}
                                                {% endif %}
                                            </div>

                                            <div class="p-1 cellule-aprem small">
                                                {% if creneauAprem is not null %}
                                                    {{ creneauAprem.creneau.heureDebut|date('H:i') }} - {{ creneauAprem.creneau.heureFin|date('H:i') }} :
                                                    {{ creneauAprem.creneau.motifAbsence ?: creneauAprem.creneau.poste }}
                                                    {% else %}
                                                        {% if absence is not null %}
                                                        <span class="text-warning">{{ absence.motif }}</span>
                                                {% else %}
                                                    <span class="text-muted">+ Après-midi</span>
                                                {% endif %}
                                                {% endif %}
                                            </div>

                                            
                                            {% set total = totaux[userId][semaineDate|date('Y-m-d')] ?? null %}

                                            <div class="mt-2 fw-bold small text-center">
                                                {% if total and total.minutes > 0 %}
                                                    Total : {{ (total.minutes / 60)|round(1) }}h00
                                                {% else %}
                                                    Total : 0h00
                                                {% endif %}
                                            </div>

                                            <div class="d-flex justify-content-center gap-4 mt-3">
                                                {% if is_granted('ROLE_ADMIN') %}
                                                {% if creneauMatin is null and creneauAprem is null %}
                                                <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#modalAbsence"
                                                        data-user-id="{{ user.id.toRfc4122() }}"
                                                        data-date="{{ semaineDate|date('Y-m-d') }}"
                                                >
                                                <i class="bi bi-calendar-x"></i>
                                                </button>
                                                    {% endif %}
                                                    <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#exampleModal"
                                                        data-creneau-matin-id="{{ creneauMatin is not null ? creneauMatin.creneau.id : '' }}"
                                                        data-heure-debut-matin="{{ creneauMatin is not null ? creneauMatin.creneau.heureDebut|date('H:i') : '' }}"
                                                        data-heure-fin-matin="{{ creneauMatin is not null ? creneauMatin.creneau.heureFin|date('H:i') : '' }}"
                                                        data-poste-matin="{{ creneauMatin is not null ? creneauMatin.creneau.poste : '' }}"
                                                        data-creneau-aprem-id="{{ creneauAprem is not null ? creneauAprem.creneau.id : '' }}"
                                                        data-heure-debut-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.heureDebut|date('H:i') : '' }}"
                                                        data-heure-fin-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.heureFin|date('H:i') : '' }}"
                                                        data-poste-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.poste : '' }}"
                                                        data-user-id="{{ user.id.toRfc4122() }}"
                                                        data-date="{{ semaineDate|date('Y-m-d') }}"
                                                        >
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# ÉQUIPE 2 #}
            <div class="tab-pane p-2" id="equipe2">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th class="text-center"><u>Agents</u></th>
                                {% for semaineDate in semaineDates %}
                                    <th class="txt-corsica-secondary text-center">
                                        <u>{{ semaineDate|format_date(pattern="EEEE d") }}</u>
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in usersTeam2 %}
                                <tr>
                                    <th class="bg-corsica-grey txt-corsica-red text-center align-middle">
                                    {% if user.id.toRfc4122 === app.user.id.toRfc4122 %}
                                    <a href="{{ path('app_planning') }}">
                                        {{ user.prenom }} <br> {{ user.nom }}
                                        </a>
                                        {% else %}
                                            {{ user.prenom }} <br> {{ user.nom }}
                                            {% endif %}
                                    </th>
                                    {% for semaineDate in semaineDates %}
                                        <td>
                                            {% set userCreneaus = user.getCreneausPourDate(semaineDate) %}
                                            {% set creneauMatin = null %}
                                            {% set creneauAprem = null %}
                                            {% for uc in userCreneaus %}
                                                {% if uc.creneau.heureDebut|date('H') < 13 %}
                                                    {% set creneauMatin = uc %}
                                                {% else %}
                                                    {% set creneauAprem = uc %}
                                                {% endif %}
                                            {% endfor %}

                                    {% set userId = user.id.toRfc4122 %}
                                    {% set absence = absences[userId][semaineDate|date('Y-m-d')]['absenceUser'] ?? null %}
                                            <div class="mb-2 p-1 border-bottom cellule-matin small">
                                                {% if creneauMatin is not null %}
                                                    {{ creneauMatin.creneau.heureDebut|date('H:i') }} - {{ creneauMatin.creneau.heureFin|date('H:i') }} :
                                                    {{ creneauMatin.creneau.motifAbsence ?: creneauMatin.creneau.poste }}
                                                     {% else %}
                                                        {% if absence is not null %}
                                                        <span class="text-warning">{{ absence.motif }}</span>
                                                {% else %}
                                                    <span class="text-muted">+ Matin</span>
                                                {% endif %}
                                                {% endif %}
                                            </div>


                                            <div class="p-1 cellule-aprem small">
                                                {% if creneauAprem is not null %}
                                                    {{ creneauAprem.creneau.heureDebut|date('H:i') }} - {{ creneauAprem.creneau.heureFin|date('H:i') }} :
                                                    {{ creneauAprem.creneau.motifAbsence ?: creneauAprem.creneau.poste }}
                                                     {% else %}
                                                        {% if absence is not null %}
                                                        <span class="text-warning">{{ absence.motif }}</span>
                                                {% else %}
                                                    <span class="text-muted">+ Après-midi</span>
                                                {% endif %}
                                                {% endif %}
                                            </div>

                                            {% set userId = user.id.toRfc4122 %}

                                            {% set total = totaux[userId][semaineDate|date('Y-m-d')] ?? null %}

                                            <div class="mt-2 fw-bold small text-center">
                                                {% if total and total.minutes > 0 %}
                                                    Total : {{ (total.minutes / 60)|round(1) }}h00
                                                {% else %}
                                                    Total : 0h00
                                                {% endif %}
                                            </div>

                                            <div class="d-flex justify-content-center gap-4 mt-3">
                                                {% if is_granted('ROLE_ADMIN') %}
                                                {% if creneauMatin is null and creneauAprem is null %}
                                                <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#modalAbsence"
                                                        data-user-id="{{ user.id.toRfc4122() }}"
                                                        data-date="{{ semaineDate|date('Y-m-d') }}"
                                                >
                                                <i class="bi bi-calendar-x"></i>
                                                </button>
                                                    {% endif %}
                                                    <button class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#exampleModal"
                                                        data-creneau-matin-id="{{ creneauMatin is not null ? creneauMatin.creneau.id : '' }}"
                                                        data-heure-debut-matin="{{ creneauMatin is not null ? creneauMatin.creneau.heureDebut|date('H:i') : '' }}"
                                                        data-heure-fin-matin="{{ creneauMatin is not null ? creneauMatin.creneau.heureFin|date('H:i') : '' }}"
                                                        data-poste-matin="{{ creneauMatin is not null ? creneauMatin.creneau.poste : '' }}"
                                                        data-creneau-aprem-id="{{ creneauAprem is not null ? creneauAprem.creneau.id : '' }}"
                                                        data-heure-debut-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.heureDebut|date('H:i') : '' }}"
                                                        data-heure-fin-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.heureFin|date('H:i') : '' }}"
                                                        data-poste-aprem="{{ creneauAprem is not null ? creneauAprem.creneau.poste : '' }}"
                                                        data-user-id="{{ user.id.toRfc4122() }}"
                                                        data-date="{{ semaineDate|date('Y-m-d') }}"
                                                        >
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </section>

    {# Modal de planification #}
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Planification</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formPlanification">
                        <input type="hidden" name="_token" value="{{ csrf_token('modifier_planning') }}">
                        <input type="hidden" name="creneauMatinId" id="creneauMatinId">
                        <input type="hidden" name="creneauApremId" id="creneauApremId">
                        <input type="hidden" name="userId" id="userId">
                        <input type="hidden" name="date" id="date">

                        <div class="mb-3">
                            <label for="horairesMatinDebut" class="col-form-label">Horaires matin début :</label>
                            <input type="time" class="form-control" id="horairesMatinDebut" name="horairesMatinDebut">
                        </div>
                        <div class="mb-3">
                            <label for="horairesMatinFin" class="col-form-label">Horaires matin fin :</label>
                            <input type="time" class="form-control" id="horairesMatinFin" name="horairesMatinFin">
                        </div>
                        <div class="mb-3">
                            <label for="horairesApremDebut" class="col-form-label">Horaires après-midi début :</label>
                            <input type="time" class="form-control" id="horairesApremDebut" name="horairesApremDebut">
                        </div>
                        <div class="mb-3">
                            <label for="horairesApremFin" class="col-form-label">Horaires après-midi fin :</label>
                            <input type="time" class="form-control" id="horairesApremFin" name="horairesApremFin">
                        </div>
                        <div class="mb-3">
                            <label for="post-select-matin">Choisir le poste du matin :</label>
                            <select name="post-matin" id="post-select-matin" class="form-select">
                                <option value="RESA/TAXE/CONV">RESA/TAXE/CONV</option>
                                <option value="CALL ENTRANT">CALL ENTRANT</option>
                                <option value="GUICHET/GM">GUICHET/GM</option>
                                <option value="DEB AC">DEB AC</option>
                                <option value="RESERVES AC">RESERVES AC</option>
                                <option value="RESERVES">RESERVES</option>
                                <option value="PK">PK</option>
                                <option value="PT DEB">PT DEB</option>
                                <option value="PT EMB">PT EMB</option>
                                <option value="GUICHET">GUICHET</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="post-select-aprem">Choisir le poste de l'après-midi :</label>
                            <select name="post-aprem" id="post-select-aprem" class="form-select">
                                <option value="RESA/TAXE/CONV">RESA/TAXE/CONV</option>
                                <option value="CALL ENTRANT">CALL ENTRANT</option>
                                <option value="GUICHET/GM">GUICHET/GM</option>
                                <option value="DEB AC">DEB AC</option>
                                <option value="RESERVES AC">RESERVES AC</option>
                                <option value="RESERVES">RESERVES</option>
                                <option value="PK">PK</option>
                                <option value="PT DEB">PT DEB</option>
                                <option value="PT EMB">PT EMB</option>
                                <option value="GUICHET">GUICHET</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="button" class="btn btn-primary" id="btnEnvoyer">Envoyer</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal absence #}
<div class="modal fade" id="modalAbsence" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Saisir une absence</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
    <form id="formAbsence">
        <input type="hidden" name="_token" value="{{ csrf_token('absence') }}">
    <input type="hidden" name="absenceUserId" id="absenceUserId">
    <input type="hidden" name="absenceDate" id="absenceDate">
    <div class="mb-3">
            <label for="motif" class="col-form-label">Motif absence :</label>
            <input type="text" class="form-control" id="motif" name="motif" required>
    </div>
       <div class="mb-3">
            <label for="debutAbs" class="col-form-label">Début :</label>
            <input type="date" class="form-control" id="debutAbs" name="debutAbs" required>
        </div>
           <div class="mb-3">
            <label for="finAbs" class="col-form-label">Fin :</label>
            <input type="date" class="form-control" id="finAbs" name="finAbs">
        </div>    
</form>
</div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="button" class="btn btn-primary" id="btnEnvoyerAbsence">Envoyer</button>
      </div>
    </div>
  </div>
</div>



    {# Navigation semaine #}
    <div class="d-flex justify-content-center py-3 gap-1 nav-semaine">
        <div class="border">
            <a href="{{ path('app_admin_planning', {'offset': offset - 1}) }}" class="btn btn-link p-0 px-2">
                <i class="bi bi-chevron-compact-left"></i> Précédent
            </a>
        </div>
        <div class="border fw-bold px-3 d-flex align-items-center">
            <p class="mb-0">Semaine {{ numeroSemaine }}</p>
        </div>
        <div class="border">
            <a href="{{ path('app_admin_planning', {'offset': offset + 1}) }}" class="btn btn-link p-0 px-2">
                 Suivant <i class="bi bi-chevron-compact-right"></i>
            </a>
        </div>
    </div>

</main>

{% block javascripts %}
    {{ parent() }}
    {{ importmap('planning_general') }}
{% endblock %}
{% endblock %}
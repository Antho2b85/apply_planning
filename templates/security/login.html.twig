{% extends 'base_login.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <header>
<div>
    <h1 class="h3 py-3 bg-corsica-red text-light text-center">Bienvenue sur Corsica Linea planning</h1>
</div>
    </header>

    <section style="background-image: url('{{ asset('images/ferry-corsica.png') }}'); background-size: cover; background-position: center; min-height: 100vh; position: relative;">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
        </div>
    {% endif %}

<div class="row h-100">
<div class="col-12 col-lg-7"></div>

<div class="col-12 col-lg-5 pt-2 pt-lg-5 d-flex d-lg-block justify-content-center">
    <form style="width: 75%;"  method="post">

    <div class="position-relative my-3">
    <i class="bi bi-person position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); z-index: 10;"></i>
    <label class="visually-hidden" for="inputEmail">Email</label>
    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" placeholder="Adresse E-mail" class="form-control opacity-75 ps-4 text-center fw-bold" autocomplete="email" required autofocus>
    </div>

    <div class="position-relative my-3">
    <i class="bi bi-lock position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); z-index: 10;"></i>
    <label class="visually-hidden" for="inputPassword">Mot de passe</label>
    <input type="password" name="password" id="inputPassword" placeholder="Mot de passe" class="form-control my-3 opacity-75 ps-4 text-center fw-bold" autocomplete="current-password" required>
    </div>
    
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

    <div class="checkbox mb-3 d-flex justify-content-center">
        <label>
            <input  type="checkbox" name="_remember_me">
            <span class="bg-dark bg-opacity-50 text-light">
             Se souvenir de moi
            </span>
        </label>
    </div>

    <div class="d-flex justify-content-center">
    <button class="btn btn-lg bg-corsica-red text-light" type="submit">
        Se connecter
    </button>
    </div>
</form>
</div>
</div>
    </section>

{{ include('_partials/_footer.html.twig') }}
{% endblock %}
